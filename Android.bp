android_app {
    name: "PenguinDex",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: ["kotlin-stdlib"],
    optimize: {
        enabled: false,
    },
}
